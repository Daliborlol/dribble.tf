+/// A fixed-size `char[N]` field. studiomdl copies names with strncpy, so a name that fills
+/// the field has no terminator and the whole field is the (truncated) name.
+fn fixed_c_string(field: &[u8], context: &str) -> Result<String, String> {
+    let length = field
+        .iter()
+        .position(|byte| *byte == 0)
+        .unwrap_or(field.len());
+    let value = std::str::from_utf8(&field[..length])
+        .map_err(|error| format!("{context} string is not UTF-8: {error}"))?;
+    Ok(value.replace('\\', "/"))
+}
