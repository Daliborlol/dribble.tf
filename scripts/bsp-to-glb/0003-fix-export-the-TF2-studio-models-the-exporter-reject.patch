+    #[test]
+    fn stores_nan_sequence_layer_range_as_full_weight_and_warns() {
+        // studiomdl writes NaN start/peak/tail/end for an addlayer without a range
+        // (c_ubersaw, demo_animations): the layer stays, with a zero range.
+        let sequence_offset = MDL_HEADER_BYTES;
+        let layer_offset = sequence_offset + 212;
+        let label_offset = layer_offset + 48;
+        let activity_offset = label_offset + 5;
+        let mut mdl = vec![0_u8; activity_offset + 9];
+        mdl[0..4].copy_from_slice(b"IDST");
+        write_i32(&mut mdl, 4, 48);
+        let mdl_length = mdl.len() as i32;
+        write_i32(&mut mdl, 76, mdl_length);
+        write_i32(&mut mdl, 188, 1);
+        write_i32(&mut mdl, 192, sequence_offset as i32);
+        write_i32(
+            &mut mdl,
+            sequence_offset + 4,
+            (label_offset - sequence_offset) as i32,
+        );
+        write_i32(
+            &mut mdl,
+            sequence_offset + 8,
+            (activity_offset - sequence_offset) as i32,
+        );
+        write_i32(&mut mdl, sequence_offset + 148, 2);
+        write_i32(
+            &mut mdl,
+            sequence_offset + 152,
+            (layer_offset - sequence_offset) as i32,
+        );
+        write_i32(
+            &mut mdl,
+            sequence_offset + 168,
+            (layer_offset - sequence_offset) as i32,
+        );
+        mdl[layer_offset..layer_offset + 2].copy_from_slice(&1_i16.to_le_bytes());
+        for field in 0..4 {
+            write_i32(
+                &mut mdl,
+                layer_offset + 8 + field * 4,
+                0xffc0_0000_u32 as i32,
+            );
+        }
+        let second = layer_offset + 24;
+        mdl[second..second + 2].copy_from_slice(&2_i16.to_le_bytes());
+        write_f32(&mut mdl, second + 8, 0.1);
+        write_f32(&mut mdl, second + 12, 0.2);
+        write_f32(&mut mdl, second + 16, 0.8);
+        write_f32(&mut mdl, second + 20, 0.9);
+        mdl[label_offset..label_offset + 5].copy_from_slice(b"idle\0");
+        mdl[activity_offset..activity_offset + 9].copy_from_slice(b"ACT_IDLE\0");
+
+        let parsed = parse_mdl(&mdl).expect("NaN layer ranges must not fail the export");
+        let layers = &parsed.sequences[0].auto_layers;
+        assert_eq!(layers.len(), 2);
+        assert_eq!(layers[0].sequence, 1);
+        assert!(layers[0].non_finite_range);
+        assert_eq!(
+            [
+                layers[0].start,
+                layers[0].peak,
+                layers[0].tail,
+                layers[0].end
+            ],
+            [0.0; 4]
+        );
+        assert!(!layers[1].non_finite_range);
+        assert_eq!(
+            [
+                layers[1].start,
+                layers[1].peak,
+                layers[1].tail,
+                layers[1].end
+            ],
+            [0.1, 0.2, 0.8, 0.9]
+        );
+        assert_eq!(parsed.warnings.len(), 1);
+        assert!(parsed.warnings[0].contains("idle#0"));
+        let json = serde_json::to_value(layers).unwrap();
+        assert_eq!(json[0]["nonFiniteRange"], true);
+        assert!(json[1].get("nonFiniteRange").is_none());
+    }
