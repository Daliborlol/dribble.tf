+/// glTF 2.0 gives every top-level array and `node.children` `minItems: 1` (validator
+/// EMPTY_ENTITY), so an animation library without meshes or materials, or a model without
+/// geometry, leaves those properties out.
+fn drop_empty_top_level_arrays(document: &mut Value) {
+    let is_empty_array = |value: &Value| value.as_array().is_some_and(Vec::is_empty);
+    if let Some(nodes) = document.get_mut("nodes").and_then(Value::as_array_mut) {
+        for node in nodes.iter_mut().filter_map(Value::as_object_mut) {
+            if node.get("children").is_some_and(is_empty_array) {
+                node.remove("children");
+            }
+        }
+    }
+    if let Some(object) = document.as_object_mut() {
+        object.retain(|_, value| !is_empty_array(value));
+    }
+}
